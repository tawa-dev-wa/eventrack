# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventrack?schema=public"

# Auth (optionnel en démo mock — sans DATABASE_URL, le login est désactivé)
BETTER_AUTH_SECRET="change-me-in-production-min-32-chars"
BETTER_AUTH_URL="https://eventrack-demo.netlify.app"
NEXT_PUBLIC_APP_URL="https://eventrack-demo.netlify.app"

# Parcours intérimaire (QR Code → URL publique Netlify pour la démo mobile)
NEXT_PUBLIC_INTERIM_DEMO_URL="https://votre-site.netlify.app"
